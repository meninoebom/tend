[
  {"name": "plain text", "input": "Buy milk", "domains": [], "expected": {"text": "Buy milk"}},
  {"name": "important star", "input": "Buy milk *", "domains": [], "expected": {"text": "Buy milk", "important": true}},
  {"name": "urgent bang", "input": "Buy milk !", "domains": [], "expected": {"text": "Buy milk", "urgent": true}},
  {"name": "star-bang both", "input": "*! Ship release", "domains": [], "expected": {"text": "Ship release", "important": true, "urgent": true}},
  {"name": "bang-star both", "input": "Ship release !*", "domains": [], "expected": {"text": "Ship release", "important": true, "urgent": true}},
  {"name": "star and bang separately", "input": "* Ship ! release", "domains": [], "expected": {"text": "Ship release", "important": true, "urgent": true}},
  {"name": "trailing punctuation is text", "input": "Call mom!", "domains": [], "expected": {"text": "Call mom!"}},
  {"name": "star inside word is text", "input": "a*b test", "domains": [], "expected": {"text": "a*b test"}},
  {"name": "double bang is text", "input": "fix it !!", "domains": [], "expected": {"text": "fix it !!"}},
  {"name": "bucket today", "input": "x >today", "domains": [], "expected": {"text": "x", "bucket": "today"}},
  {"name": "bucket soon", "input": "x >soon", "domains": [], "expected": {"text": "x", "bucket": "soon"}},
  {"name": "bucket later", "input": ">later read book", "domains": [], "expected": {"text": "read book", "bucket": "later"}},
  {"name": "bucket someday", "input": "learn piano >someday", "domains": [], "expected": {"text": "learn piano", "bucket": "someday"}},
  {"name": "bucket case-insensitive", "input": "x >LATER", "domains": [], "expected": {"text": "x", "bucket": "later"}},
  {"name": "unknown bucket stays", "input": "x >tomorrow", "domains": [], "expected": {"text": "x >tomorrow"}},
  {"name": "bare gt stays", "input": "a > b", "domains": [], "expected": {"text": "a > b"}},
  {"name": "last bucket wins", "input": "x >soon >later", "domains": [], "expected": {"text": "x", "bucket": "later"}},
  {"name": "size small", "input": "x ~s", "domains": [], "expected": {"text": "x", "size": "s"}},
  {"name": "size medium", "input": "x ~m", "domains": [], "expected": {"text": "x", "size": "m"}},
  {"name": "size large uppercase", "input": "x ~L", "domains": [], "expected": {"text": "x", "size": "l"}},
  {"name": "unknown size stays", "input": "x ~x", "domains": [], "expected": {"text": "x ~x"}},
  {"name": "long tilde stays", "input": "about ~5min", "domains": [], "expected": {"text": "about ~5min"}},
  {"name": "domain full name", "input": "run #health", "domains": ["Work", "Health"], "expected": {"text": "run", "domain": "Health"}},
  {"name": "domain prefix", "input": "run #hea", "domains": ["Work", "Health"], "expected": {"text": "run", "domain": "Health"}},
  {"name": "domain case-insensitive", "input": "run #HEALTH", "domains": ["Work", "health"], "expected": {"text": "run", "domain": "health"}},
  {"name": "domain first match wins", "input": "x #p", "domains": ["Personal", "Projects"], "expected": {"text": "x", "domain": "Personal"}},
  {"name": "domain binds once", "input": "x #work #health", "domains": ["Work", "Health"], "expected": {"text": "x #health", "domain": "Work"}},
  {"name": "unknown tag stays", "input": "read #fiction", "domains": ["Work", "Health"], "expected": {"text": "read #fiction"}},
  {"name": "unknown tag then known", "input": "read #fiction #work", "domains": ["Work"], "expected": {"text": "read #fiction", "domain": "Work"}},
  {"name": "bare hash stays", "input": "item # 3", "domains": ["Work"], "expected": {"text": "item # 3"}},
  {"name": "no domains, tag stays", "input": "x #work", "domains": [], "expected": {"text": "x #work"}},
  {"name": "everything", "input": "call dentist #health ! ~s", "domains": ["Work", "Health"], "expected": {"text": "call dentist", "urgent": true, "size": "s", "domain": "Health"}},
  {"name": "everything plus bucket", "input": "*! #wo plan launch >soon ~l", "domains": ["Work"], "expected": {"text": "plan launch", "important": true, "urgent": true, "bucket": "soon", "size": "l", "domain": "Work"}},
  {"name": "extra whitespace collapses", "input": "  a   b\tc  ", "domains": [], "expected": {"text": "a b c"}},
  {"name": "only tokens leaves empty text", "input": "* ! >later ~m", "domains": [], "expected": {"text": "", "important": true, "urgent": true, "bucket": "later", "size": "m"}},
  {"name": "tag longer than domain stays", "input": "start #healthcare", "domains": ["Health"], "expected": {"text": "start #healthcare"}},
  {"name": "punctuated bucket stays", "input": "x >later.", "domains": [], "expected": {"text": "x >later."}},
  {"name": "punctuated size stays", "input": "x ~s,", "domains": [], "expected": {"text": "x ~s,"}},
  {"name": "repeated star", "input": "x * *", "domains": [], "expected": {"text": "x", "important": true}},
  {"name": "second matching tag stays after bind", "input": "x #work #wo", "domains": ["Work"], "expected": {"text": "x #wo", "domain": "Work"}},
  {"name": "empty input", "input": "", "domains": [], "expected": {"text": ""}}
]
